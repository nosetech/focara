# Focara 設定ファイル。config.yaml にコピーして使う(config.yaml は .gitignore 対象)。
# 設定ファイルのパスは環境変数 FOCARA_CONFIG で上書きできる。反映にはアプリの再起動が必要。

# launchd ジョブ名(com.nosetech.focara.<instance>.<job>)などに使う。
instance: default

backend:
  port: 8800 # 常に 127.0.0.1 に bind する

frontend:
  port: 3800 # bind 先は環境変数 LAN_IP / TAILSCALE_IP で指定(未指定は 127.0.0.1)

db:
  path: data/focara.db

log:
  dir: logs

ui:
  # この時刻(0〜23)以降、未完了が残っていると実行画面が「1日の予定を終えた」画面に切り替わる
  day_end_hour: 22

habit:
  # 習慣の子タスクを、今日から何日先まで先行生成するか(1〜365)
  generate_ahead_days: 14

ai:
  # AI(Claude Code CLI の claude -p)を実行する専用の作業ディレクトリ。スキル・プロンプトを置く
  workdir: data/ai
  # Claude Code CLI のコマンド(PATH 上の名前か絶対パス)。サブスクリプションの Claude Code を使う
  claude_command: claude
  # 1回の実行の上限秒数(1〜86400)。超えると停止してエラーにする
  timeout_seconds: 600
  # 実行ログ(log.dir 配下の ai/)の保持日数(1〜3650)
  log_retention_days: 30
