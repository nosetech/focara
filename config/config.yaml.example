# Focara 設定ファイル。config.yaml にコピーして使う(config.yaml は .gitignore 対象)。
# 設定ファイルのパスは環境変数 FOCARA_CONFIG で上書きできる。反映にはアプリの再起動が必要。

# launchd ジョブ名(com.nosetech.focara.<instance>.<job>)などに使う。
instance: default

backend:
  port: 8800 # 常に 127.0.0.1 に bind する

frontend:
  port: 3800
  # 公開用の bind 先。127.0.0.1(ローカルのみ) / 0.0.0.0(LAN) / Tailscale の IP など
  host: 127.0.0.1

db:
  path: data/focara.db

log:
  dir: logs
