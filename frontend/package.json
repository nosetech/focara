{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p ${FRONTEND_PORT:-3800}",
    "build": "next build",
    "start": "next start -p ${FRONTEND_PORT:-3800}",
    "lint": "eslint",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "test": "node --test"
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "^5"
  }
}
